    },
    {
        "id": "86962c99e277e363",
        "type": "inject",
        "z": "715094ef3dcc89d8",
        "name": "🌍 Weather API data",
        "repeat": "",
        "once": false,
        "payload": "[{\"city\":\"Kyiv\",\"temp\":22,\"humidity\":60,\"wind\":5},{\"city\":\"Lviv\",\"temp\":17,\"humidity\":72,\"wind\":8},{\"city\":\"Odesa\",\"temp\":28,\"humidity\":55,\"wind\":3},{\"city\":\"Kharkiv\",\"temp\":15,\"humidity\":80,\"wind\":12},{\"city\":\"Dnipro\",\"temp\":24,\"humidity\":50,\"wind\":6},{\"city\":\"Zaporizhzhia\",\"temp\":26,\"humidity\":48,\"wind\":4},{\"city\":\"Mykolaiv\",\"temp\":19,\"humidity\":65,\"wind\":7},{\"city\":\"Poltava\",\"temp\":21,\"humidity\":58,\"wind\":5},{\"city\":\"Vinnytsia\",\"temp\":18,\"humidity\":70,\"wind\":9},{\"city\":\"Cherkasy\",\"temp\":23,\"humidity\":62,\"wind\":6}]",
        "payloadType": "json",
        "x": 160,
        "y": 100,
        "wires": [
            [
                "016bb5658e9fa314",
                "85d495d777e0f116",
                "de60e96795ea43d4"
            ]
        ]
    },
    {
        "id": "607aef74ea535892",
        "type": "comment",
        "z": "715094ef3dcc89d8",
        "name": "✅ OPTION 1 — data-pipeline (1 node, no code)",
        "info": "",
        "x": 650,
        "y": 100,
        "wires": []
    },
    {
        "id": "016bb5658e9fa314",
        "type": "data-pipeline",
        "z": "715094ef3dcc89d8",
        "name": "filter → pick → sort → limit",
        "steps": "[{\"type\":\"filter\",\"params\":{\"field\":\"temp\",\"op\":\">\",\"value\":\"20\"}},{\"type\":\"pick\",\"params\":{\"fields\":\"city, temp\"}},{\"type\":\"sort\",\"params\":{\"field\":\"temp\",\"order\":\"desc\"}},{\"type\":\"limit\",\"params\":{\"count\":\"5\"}}]",
        "x": 580,
        "y": 160,
        "wires": [
            [
                "0e5ed2de2e6b1d28"
            ],
            []
        ]
    },
    {
        "id": "0e5ed2de2e6b1d28",
        "type": "debug",
        "z": "715094ef3dcc89d8",
        "name": "✅ result",
        "active": true,
        "tosidebar": true,
        "complete": "payload",
        "targetType": "msg",
        "x": 810,
        "y": 160,
        "wires": []
    },
    {
        "id": "a879ec8bbbabbe1a",
        "type": "comment",
        "z": "715094ef3dcc89d8",
        "name": "⚠️ OPTION 2 — function node (requires JS knowledge)",
        "info": "",
        "x": 660,
        "y": 260,
        "wires": []
    },
    {
        "id": "85d495d777e0f116",
        "type": "function",
        "z": "715094ef3dcc89d8",
        "name": "filter+pick+sort+limit (JS)",
        "func": "msg.payload = msg.payload\n    .filter(x => x.temp > 20)\n    .map(x => ({ city: x.city, temp: x.temp }))\n    .sort((a, b) => b.temp - a.temp)\n    .slice(0, 5)\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 300,
        "wires": [
            [
                "d8036fd9c2da5856"
            ]
        ]
    },
    {
        "id": "d8036fd9c2da5856",
        "type": "debug",
        "z": "715094ef3dcc89d8",
        "name": "⚠️ result",
        "active": true,
        "tosidebar": true,
        "complete": "payload",
        "targetType": "msg",
        "x": 800,
        "y": 300,
        "wires": []
    },
    {
        "id": "1b67cb98911690ca",
        "type": "comment",
        "z": "715094ef3dcc89d8",
        "name": "❌ OPTION 3 — 6 chained nodes: split → switch → change → join → sort → limit",
        "info": "",
        "x": 610,
        "y": 400,
        "wires": []
    },
    {
        "id": "de60e96795ea43d4",
        "type": "split",
        "z": "715094ef3dcc89d8",
        "name": "split",
        "splt": "\\n",
        "spltType": "str",
        "arraySplt": 1,
        "arraySpltType": "len",
        "stream": false,
        "addname": "payload",
        "property": "payload",
        "x": 200,
        "y": 460,
        "wires": [
            [
                "8a646db160e025bd"
            ]
        ]
    },
    {
        "id": "8a646db160e025bd",
        "type": "switch",
        "z": "715094ef3dcc89d8",
        "name": "filter: temp > 20",
        "property": "payload.temp",
        "propertyType": "msg",
        "rules": [
            {
                "t": "gt",
                "v": "20",
                "vt": "num"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 370,
        "y": 460,
        "wires": [
            [
                "1302061c3c4c65af"
            ]
        ]
    },
    {
        "id": "1302061c3c4c65af",
        "type": "change",
        "z": "715094ef3dcc89d8",
        "name": "pick: city + temp",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "{\"city\": payload.city, \"temp\": payload.temp}",
                "tot": "jsonata"
            }
        ],
        "x": 550,
        "y": 460,
        "wires": [
            [
                "d7862242e2b36a03"
            ]
        ]
    },
    {
        "id": "d7862242e2b36a03",
        "type": "join",
        "z": "715094ef3dcc89d8",
        "name": "join",
        "mode": "auto",
        "build": "array",
        "x": 710,
        "y": 460,
        "wires": [
            [
                "22e5af152eb25517"
            ]
        ]
    },
    {
        "id": "22e5af152eb25517",
        "type": "function",
        "z": "715094ef3dcc89d8",
        "name": "sort desc",
        "func": "msg.payload = msg.payload.sort((a, b) => b.temp - a.temp)\nreturn msg;",
        "outputs": 1,
        "x": 855,
        "y": 460,
        "wires": [
            [
                "e0da349687af76a0"
            ]
        ]
    },
    {
        "id": "e0da349687af76a0",
        "type": "function",
        "z": "715094ef3dcc89d8",
        "name": "limit top 5",
        "func": "msg.payload = msg.payload.slice(0, 5)\nreturn msg;",
        "outputs": 1,
        "x": 1000,
        "y": 460,
        "wires": [
            [
                "d53f5b90b5a0a103"
            ]
        ]
